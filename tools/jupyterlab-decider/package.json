{
  "name": "jupyterlab-decider",
  "version": "0.0.1",
  "description": "Visualise, run and step through decider pipelines in JupyterLab",
  "private": true,
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "style"
  ],
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "scripts": {
    "build": "pnpm --filter @decider/ui build && tsc && uv run jupyter labextension build .",
    "e2e": "pnpm build && vitest run"
  },
  "dependencies": {
    "@decider/ui": "workspace:*",
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/docmanager": "^4.0.0",
    "@jupyterlab/filebrowser": "^4.0.0",
    "@jupyterlab/fileeditor": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/services": "^7.0.0",
    "@jupyterlab/ui-components": "^4.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "decider_jupyter/labextension"
  }
}
