{
  "name": "decider-vscode",
  "displayName": "decider",
  "description": "Visualise, run and step through decider pipelines",
  "version": "0.0.1",
  "publisher": "capitec",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/capitec/dsp-decision-engine.git",
    "directory": "tools/vscode-decider"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Debuggers",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onDebugResolve:decider"
  ],
  "contributes": {
    "commands": [
      {
        "command": "decider.visualise",
        "title": "decider: Visualise flow"
      },
      {
        "command": "decider.runFlow",
        "title": "decider: Run flow with inputs"
      },
      {
        "command": "decider.debugStep",
        "title": "decider: Debug this step in Python",
        "icon": "$(debug-alt)"
      },
      {
        "command": "decider.trace",
        "title": "decider: Trace a column's lineage"
      },
      {
        "command": "decider.focusRecord",
        "title": "decider: Focus one record"
      },
      {
        "command": "decider.compareRevision",
        "title": "decider: Compare flow with a git revision…",
        "icon": "$(git-compare)"
      },
      {
        "command": "decider.whatIf",
        "title": "decider: What-if (params and inputs)"
      },
      {
        "command": "decider.openPipeline",
        "title": "decider: Open a pipeline.py"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "decider.compareRevision",
          "when": "resourceLangId == python",
          "group": "navigation"
        }
      ],
      "debug/toolBar": [
        {
          "command": "decider.debugStep",
          "when": "debugType == decider"
        }
      ],
      "commandPalette": [
        {
          "command": "decider.debugStep",
          "when": "debugType == decider"
        },
        {
          "command": "decider.trace",
          "when": "debugType == decider"
        },
        {
          "command": "decider.focusRecord",
          "when": "debugType == decider"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "decider",
          "title": "decider",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "decider": [
        {
          "id": "decider.structure",
          "name": "Structure"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "decider.structure",
        "contents": "No flow shown yet.\n\nOpen the file that defines your pipeline, `def build()` or `pipeline = flow(...)`, and click **Visualise flow** in the line above it. The flow's steps appear here and in the flow panel.\n\n[Open a pipeline.py](command:decider.openPipeline)\n\nNo pipeline yet? `decider template NAME` writes a starter project."
      }
    ],
    "configuration": {
      "title": "decider",
      "properties": {
        "decider.python": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Command that runs Python for decider tools, e.g. [\"uv\", \"run\", \"python\"]. Empty: the ms-python interpreter, then python3."
        }
      }
    },
    "breakpoints": [
      {
        "language": "python"
      }
    ],
    "debuggers": [
      {
        "type": "decider",
        "label": "decider pipeline",
        "languages": [
          "python"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Python file defining the pipeline"
              },
              "pipeline": {
                "type": "string",
                "description": "Module-level name of the pipeline (default: the first one found)"
              },
              "data": {
                "description": "Input rows: a list of records, or the path of a JSON file. Default: the module's SAMPLE"
              },
              "params": {
                "type": "object",
                "description": "A params document for the run"
              },
              "record": {
                "type": "integer",
                "description": "Show this record's values instead of batch previews"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "decider",
            "request": "launch",
            "name": "decider: run pipeline",
            "program": "${file}",
            "stopOnEntry": true
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "pnpm --filter @decider/ui build && vite build && vite build --config vite.webview.config.ts",
    "watch": "vite build --watch",
    "test": "pnpm build && vitest run",
    "test:vscode": "pnpm build && node dist/runVsCodeTests.js",
    "test:e2e": "pnpm build && E2E=1 vitest run",
    "test:stories": "pnpm build && E2E=stories vitest run",
    "test:large": "pnpm build && E2E=large vitest run",
    "test:controls": "pnpm build && E2E=controls vitest run",
    "test:features": "pnpm build && E2E=features vitest run",
    "package": "pnpm build && cp ../../LICENSE . && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@decider/ui": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "~1.120.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugadapter-testsupport": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "mocha": "^12.0.2",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
