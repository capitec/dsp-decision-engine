{
  "artefact": "suppression_registry",
  "version": "2026-09",
  "effective_from": "2026-09-01",
  "owner": "regulatory_compliance",
  "co_owner": "campaign_analytics",

  "_note": "This is an INTERIOR document in doc 08 §3's sense: a UI writes it, it cannot reach anything the ruleset's declared reads/writes do not name, and the vocabulary is closed. `bit_index` is assigned once per code FOR LIFE and never reused, because it is the join key in the warehouse and in 25 months of stored masks. `class` is what `absolute_mask` is derived from and is a Compliance-owned VALUE - flipping one is a params change, not a recompile.",

  "suppressions": [
    {"code": "S01", "bit_index": 0,  "scope": "all",      "class": "absolute",
     "description": "Deceased or estate in progress",
     "when": {"op": "is_true", "feature": "eligibility:deceased_or_estate"},
     "sept_volume": 41200},
    {"code": "S02", "bit_index": 1,  "scope": "all",      "class": "measurement",
     "description": "Debt review or debt counselling",
     "when": {"op": "is_true", "feature": "eligibility:debt_review"},
     "sept_volume": 318400},
    {"code": "S03", "bit_index": 2,  "scope": "all",      "class": "measurement",
     "description": "Administration order",
     "when": {"op": "is_true", "feature": "eligibility:administration_order"},
     "sept_volume": 12700},
    {"code": "S04", "bit_index": 3,  "scope": "all",      "class": "measurement",
     "description": "Insolvency or sequestration",
     "when": {"op": "is_true", "feature": "eligibility:insolvency"},
     "sept_volume": 8900},
    {"code": "S05", "bit_index": 4,  "scope": "all",      "class": "measurement",
     "description": "Legal action in progress",
     "when": {"op": "is_true", "feature": "feature:legal_action_flag"},
     "sept_volume": 64300},
    {"code": "S06", "bit_index": 5,  "scope": "all",      "class": "measurement",
     "description": "Staff, director or related party",
     "when": {"op": "is_true", "feature": "feature:related_party_flag"},
     "sept_volume": 27600},
    {"code": "S07", "bit_index": 6,  "scope": "all",      "class": "measurement",
     "description": "Marketing opt-out",
     "when": {"op": "is_false", "feature": "consent:marketing"},
     "sept_volume": 1042000,
     "_why_measurement": "The analytics team reports the population that WOULD have been targeted. 1.04 M opted-out clients still traverse every tree and still get a route recorded; they simply never reach dispatch."},
    {"code": "S08", "bit_index": 7,  "scope": "channel",  "class": "measurement",
     "description": "Per-channel consent absent",
     "when": {"op": "is_false", "feature": "consent:channel"},
     "sept_volume": {"sms": 384000, "call": 706000, "email": 1180000, "in_app": 51000}},
    {"code": "S09", "bit_index": 8,  "scope": "all",      "class": "measurement",
     "description": "Active complaint or dispute",
     "when": {"op": "is_true", "feature": "feature:active_complaint_flag"},
     "sept_volume": 22400},
    {"code": "S11", "bit_index": 10, "scope": "all",      "class": "absolute",
     "description": "Fraud marker on client or device",
     "when": {"op": "is_true", "feature": "feature:fraud_marker"},
     "sept_volume": 18300},
    {"code": "S14", "bit_index": 13, "scope": "all",      "class": "absolute",
     "description": "Compliance do-not-target list",
     "when": {"op": "is_true", "feature": "compliance:do_not_target"},
     "sept_volume": 3100},
    {"code": "S15", "bit_index": 14, "scope": "channel",  "class": "measurement",
     "description": "Invalid or duplicate contact detail",
     "when": {"op": "is_false", "feature": "feature:contact_detail_valid"},
     "sept_volume": 620000},
    {"code": "S17", "bit_index": 16, "scope": "all",      "class": "measurement",
     "description": "Non-resident or address unverified",
     "when": {"op": "is_true", "feature": "feature:address_unverified"},
     "sept_volume": 96500},
    {"code": "S21", "bit_index": 20, "scope": "campaign", "class": "measurement",
     "description": "Recent decline, within cooling-off",
     "when": {"op": "step", "step": "suppression:in_cooling_off"},
     "sept_volume": 205000},
    {"code": "S22", "bit_index": 21, "scope": "campaign", "class": "measurement",
     "description": "In-flight application for the same product",
     "when": {"op": "is_true", "feature": "feature:inflight_application"},
     "sept_volume": 71800},
    {"code": "S23", "bit_index": 22, "scope": "campaign", "class": "measurement",
     "description": "Product already held at or above the offered tier",
     "when": {"op": "step", "step": "suppression:product_held_at_or_above_tier"},
     "sept_volume": 2410000},
    {"code": "S24", "bit_index": 23, "scope": "campaign", "class": "measurement",
     "description": "Post-sale quiet period, 30 days from take-up",
     "when": {"op": "le", "feature": "feature:days_since_takeup", "value": {"param": "quiet_period_days"}},
     "sept_volume": 188000},
    {"code": "S30", "bit_index": 29, "scope": "client",   "class": "measurement",
     "description": "Contact fatigue, all-channel cap",
     "when": {"op": "step", "step": "suppression:fatigue_exceeded"},
     "sept_volume": 890000},
    {"code": "S31", "bit_index": 30, "scope": "channel",  "class": "measurement",
     "description": "Contact fatigue, per-channel sub-cap",
     "when": {"op": "step", "step": "suppression:fatigue_exceeded"},
     "sept_volume": {"sms": 1340000, "call": 410000}}
  ],

  "derived": {
    "absolute_mask": "0x0000000000002401",
    "_derivation": "sum(1 << bit_index) over class == 'absolute'. Bits 0 (S01), 10 (S11), 13 (S14). Regenerated by `decider registry masks` and written into the params document; the cycle refuses to start if the mask and the registry disagree.",
    "reconciliation": "Spec §5.2 req 2: the count removed by each suppression, per campaign, is reconciled monthly and a 20% movement raises BEFORE dispatch. The sept_volume figures above are last cycle's actuals and are what the movement is measured against."
  }
}
