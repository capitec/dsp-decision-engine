{
  "$schema": "decider2://input_schema/1",
  "pipeline": "flex_loan_granting",
  "_comment": "`decider build` needs this: column dtypes and NULLABILITY decide the record dtype, the numba signature and the Maybe-vs-plain choice per step. Note that every ragged collection declares a capacity and an overflow policy -- there is no heap in the record tier, and an undeclared capacity is a build error rather than a runtime surprise at the 81st bureau account.",
  "scalars": [
    {"name": "application_id", "dtype": "int64", "nullable": false},
    {"name": "client_id", "dtype": "int64", "nullable": false},
    {"name": "decision_date", "dtype": "date", "nullable": false,
     "note": "Governs every table version. Never 'today'. Required by `tables.resolve`."},
    {"name": "product_code", "dtype": "int16", "nullable": false},
    {"name": "channel_code", "dtype": "int8", "nullable": false},
    {"name": "requested_amount", "dtype": "int64_cents", "nullable": true,
     "absence_reasons": ["not_stated_pre_assessment", "not_stated_qualify_journey"],
     "note": "Null on 31% of app-channel volume. BIND-REQ and BIND-MAX are different binding constraints, so this is NOT defaulted to the product maximum."},
    {"name": "requested_term_months", "dtype": "int16", "nullable": true},
    {"name": "purpose_code", "dtype": "int8", "nullable": true},
    {"name": "is_joint_application", "dtype": "bool", "nullable": false},
    {"name": "campaign_id", "dtype": "int32", "nullable": true},
    {"name": "applicant_age_years", "dtype": "float64", "nullable": false},
    {"name": "employment_type_code", "dtype": "int8", "nullable": false},
    {"name": "months_employed", "dtype": "float64", "nullable": true,
     "absence_reasons": ["self_employed_no_tenure"]},
    {"name": "employer_id", "dtype": "int32", "nullable": true},
    {"name": "residency_code", "dtype": "int8", "nullable": false},
    {"name": "credit_life_substitution_declared", "dtype": "bool", "nullable": false},
    {"name": "internal_tenure_months", "dtype": "float64", "nullable": true,
     "absence_reasons": ["new_to_bank"]},
    {"name": "internal_exposure_total", "dtype": "int64_cents", "nullable": false},
    {"name": "group_exposure_limit", "dtype": "int64_cents", "nullable": false},
    {"name": "debt_review_status_code", "dtype": "int8", "nullable": false},
    {"name": "administration_order_flag", "dtype": "bool", "nullable": false},
    {"name": "insolvency_status_code", "dtype": "int8", "nullable": false},
    {"name": "deceased_flag", "dtype": "bool", "nullable": false},
    {"name": "estate_flag", "dtype": "bool", "nullable": false},
    {"name": "bureau_as_of_date", "dtype": "date", "nullable": true,
     "absence_reasons": ["no_bureau_record", "bureau_enquiry_failed"]},
    {"name": "bureau_subject_count", "dtype": "int8", "nullable": false},
    {"name": "bureau_enquiry_succeeded", "dtype": "bool", "nullable": false},
    {"name": "fraud_verdict_code", "dtype": "int8", "nullable": false},
    {"name": "fraud_response_ms", "dtype": "float64", "nullable": false},
    {"name": "max_affordable_instalment", "dtype": "int64_cents", "nullable": true},
    {"name": "affordability_verdict_code", "dtype": "int8", "nullable": false}
  ],
  "ragged": [
    {"name": "bureau_accounts", "element": "BureauAccount", "capacity": 80,
     "on_overflow": "flag", "overflow_flag": "bureau_accounts_truncated",
     "note": "Median 7, p95 23, p99 41. An overflow is a DATA QUALITY FACT (DQ-2) and must produce a value, not an exception."},
    {"name": "bureau_enquiries", "element": "Enquiry", "capacity": 120, "on_overflow": "flag"},
    {"name": "bureau_public_records", "element": "PublicRecord", "capacity": 25, "on_overflow": "flag"},
    {"name": "internal_accounts", "element": "InternalAccount", "capacity": 40, "on_overflow": "error"},
    {"name": "in_flight_applications", "element": "Application", "capacity": 6, "on_overflow": "flag"},
    {"name": "consent_records", "element": "ConsentRecord", "capacity": 12, "on_overflow": "error"},
    {"name": "exclusion_list_hits", "element": "ExclusionHit", "capacity": 5, "on_overflow": "error"},
    {"name": "fraud_reason_codes", "element": "int16", "capacity": 8, "on_overflow": "flag"},
    {"name": "applicants", "element": "Applicant", "capacity": 2, "on_overflow": "error",
     "note": "Change scenario 14: joint applications move from one blended assessment to two graded applicants with a worse-of rule. Capacity 2 today, and the Map/worse-of shape is already the one the offer set uses -- which is the whole argument for a collection combinator existing at all."}
  ],
  "structs": [
    {"name": "behaviour_summary", "fields": 11, "nullable": true,
     "absence_reasons": ["new_to_bank"]}
  ]
}
