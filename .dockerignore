# Ignore everything then whitelist what the image actually needs
*

# Package source (the builder stage builds the wheel from these)
!/decider
!/pyproject.toml
!/README.md

# In-repo example projects (PROJECT=examples/<name>), without their tests and generators
!/examples
/examples/*/tests
/examples/*/scripts

# Docker helpers
!/docker/bake.sh

# Strip noise from allowed directories
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/*.egg-info
**/.DS_Store
**/Thumbs.db
**/*.log
**/.git
**/.mypy_cache
**/.pytest_cache
**/.hypothesis
**/.coverage
**/.coverage.*
**/.tox
